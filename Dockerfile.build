# Self-contained build — compiles from source, no prebuilt binary required.
# Use this to run the fork directly (docker build / compose `build:`).
# The goreleaser release flow uses ./Dockerfile (prebuilt binary) instead.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /animeman ./cmd/service

FROM alpine AS certs
RUN apk add --no-cache ca-certificates

FROM scratch
COPY --from=certs /etc/ssl/certs /etc/ssl/certs
COPY --from=build /animeman /usr/bin/animeman
ENTRYPOINT ["/usr/bin/animeman"]
